{
  "_schema": {
    "note": "Congress metadata — hand-authored (dates verified from official society sources, not scraped). Ordered by start_date.",
    "fields": {
      "slug": "url slug, e.g. asco-2026",
      "short_name": "display code, e.g. ASCO 2026",
      "society_short": "society acronym",
      "society_full": "full society + meeting name (Design header copy)",
      "start_date": "ISO YYYY-MM-DD, first day",
      "end_date": "ISO YYYY-MM-DD, last day",
      "city": "host city",
      "state": "US state abbrev or null",
      "country": "host country",
      "venue": "host venue or null",
      "hashtags": "LOWERCASE, WITH # PREFIX — must match social_posts_v2.hashtags exactly (e.g. #asco26)",
      "ta_relevance": "object keyed by TA slug -> high|moderate|low (drives time-rail marker weight)",
      "society_url": "official society URL",
      "abstract_source": "path to an abstract metadata file if we hold one (enables confirmed-presenter treatment); null otherwise",
      "social_capture_start": "first observed capture date for the hashtag, or null — chart never draws days before this (unobserved != zero)"
    }
  },
