# --- Credentials and environment ---
.env
.env.*
*.env
frontend/.env
frontend/.env.*
*credentials*
*secrets*
*api_key*
*.pem
*.key

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
venv/
.venv/

# --- OS / Editor metadata ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# --- Office temporary files (Word lock files etc.) ---
~$*

# --- Word documents (binary, hard to diff; markdown preferred for docs) ---
*.docx

# --- Frontend build artifacts ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/

# --- Data directories (large files, not for version control) ---
Medicare/
OpenPayments/
NPPES/
www/

# --- Database backup dumps ---
*.dump
*.sql.gz
*.bak
backups/

# --- Large data files at root ---
*.parquet
*.csv
*.zip

# --- Pipeline checkpoint files (resumable state, not source) ---
*_checkpoint.json
*checkpoint*.json

# --- Pipeline log files (output, not source) ---
*_log_*.json
*_log.json
hcp_dedup_*.json
dedupe_audit_output*.json
workstream_b_dryrun_results.json
rohit_loomba_82_rows.json

# --- One-off investigation/scratch files ---
category_c_investigation.txt
files.zip
frontend_dump.md

# --- Existing untracked files we don't want to track ---
fieldmark_backup_premerge.dump
Twitter API.txtno_fit_*.json
failed_batches_*.json
node_modules/

